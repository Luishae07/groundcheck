{
  "manifest_version": 3,
  "name": "Flowsearch + Groundcheck",
  "version": "1.0.0",
  "description": "Search with Flowsearch and see the weather measured near you by Groundcheck, using your location.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Flowsearch + Groundcheck",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib.js", "background.js"]
  },
  "omnibox": { "keyword": "fs" },
  "permissions": ["geolocation", "storage", "alarms"],
  "host_permissions": [
    "https://luishae07.github.io/*",
    "https://raw.githubusercontent.com/*",
    "https://*.trycloudflare.com/*"
  ],
  "browser_specific_settings": {
    "gecko": { "id": "flowsearch-groundcheck@luishae07", "strict_min_version": "127.0" }
  }
}
